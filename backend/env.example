# ─────────────────────────────────────────────
# .env.example
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# ─────────────────────────────────────────────

# PostgreSQL 接続文字列
# ローカル例: postgres://postgres:password@localhost:5432/salon_calendar
# Railway:  自動で設定されます（手動設定不要）
DATABASE_URL=postgres://postgres:password@localhost:5432/salon_calendar

# JWT 署名キー（32文字以上のランダムな文字列に変更してください）
JWT_SECRET=change-this-to-a-random-secret-string-32chars

# 環境（development / production）
NODE_ENV=development
